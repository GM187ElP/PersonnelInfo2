@using System.Reflection;
@using System.ComponentModel.DataAnnotations;
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using PersonellInfo.Blazor.Services
@inject ValidationServices ValidationService

@code {
    [CascadingParameter] private EditContext CurrentEditContext { get; set; }
    [Parameter] public object Model { get; set; }

    private ValidationMessageStore _messageStore;

    private bool _eventsAttached = false;

protected override void OnParametersSet()
{
    if (!_eventsAttached && CurrentEditContext != null)
    {
        _messageStore = new ValidationMessageStore(CurrentEditContext);

        CurrentEditContext.OnValidationRequested += async (s, e) =>
        {
            await Task.Yield(); // allow binding to complete
            ValidateModel();
        };

        _eventsAttached = true;
    }
}

    private record FieldError(string MemberName, string ErrorKey, string ErrorMessage);

    private void ValidateModel()
    {
        _messageStore.Clear();

        var context = new ValidationContext(Model);
        var results = new List<ValidationResult>();
        Validator.TryValidateObject(Model, context, results, validateAllProperties: true);

        foreach (var result in results)
        {
            foreach (var field in result.MemberNames)
            {
                var prop = Model.GetType().GetProperty(field);
                if (prop == null) continue;

                // Infer which attribute failed (same logic as before)
                string errorKey = null;
                var value = prop.GetValue(Model);

                var attrs = prop.GetCustomAttributes<ValidationAttribute>(true).Cast<ValidationAttribute>();
                foreach (var attr in attrs)
                {
                    var attrContext = new ValidationContext(Model) { MemberName = prop.Name };
                    if (attr.GetValidationResult(value, attrContext)?.ErrorMessage == result.ErrorMessage)
                    {
                        errorKey = attr.GetType().Name.Replace("Attribute", "");
                        break;
                    }
                }

                var msg = ValidationService.GetError(Model.GetType().Name, field, errorKey ?? "Unknown", "Fa");
                _messageStore.Add(CurrentEditContext.Field(field), msg);
            }
        }

        CurrentEditContext.NotifyValidationStateChanged();
    }


}
