@page "/"
@using PersonnelInfo.Application.Interfaces.Entities
@using PersonnelInfo.Core.DTOs.Entities.Employees
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject HttpClient httpClient
@inject IDisplayName displayName

<h3>Employees</h3>

<MudTable T="EmployeeDto"
          ServerData="LoadServerData"
          ServerSide="true"
          RowsPerPage="50"
          Dense="@dense"
          Hover="@hover"
          Bordered="@bordered"
          Striped="@striped"
          Filter="FilterFunc"
          @bind-SelectedItem="selectedEmployee">

    <ToolBarContent>
        <MudText Typo="Typo.h6">Employees</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="searchString"
                      Placeholder="Search"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      Class="mt-0"
                      Immediate="true"
                      OnBlurred="ReloadTable"
                      OnKeyUp="@(async _ => await ReloadTable())" />
    </ToolBarContent>

    <HeaderContent>
        <MudTh>Id</MudTh>
        <MudTh>Code</MudTh>
        <MudTh>First Name</MudTh>
        <MudTh>Last Name</MudTh>
        <MudTh>National ID</MudTh>
        <MudTh>Contact</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd>@context.Id</MudTd>
        <MudTd>@context.PersonnelCode</MudTd>
        <MudTd>@context.FirstName</MudTd>
        <MudTd>@context.LastName</MudTd>
        <MudTd>@context.NationalId</MudTd>
        <MudTd>@context.ContactNumber</MudTd>
    </RowTemplate>

    <PagerContent>
        <MudTablePager />
    </PagerContent>

</MudTable>











@code {
    private string searchString = "";
    private bool dense = false;
    private bool hover = true;
    private bool striped = false;
    private bool bordered = false;
    private EmployeeDto selectedEmployee;
    private MudTable<EmployeeDto> _table;

    [Inject] private IOptions<ApiConfiguration> apiConfig { get; set; }

    private async Task<TableData<EmployeeDto>> LoadServerData(TableState state,CancellationToken cancellationToken=default)
    {
        var page = state.Page + 1;
        var pageSize = state.PageSize;

        var url = $"{apiConfig.Value.Url}/api/employee?page={page}&pageSize={pageSize}&search={searchString}";
        using var client = new HttpClient();
        var result = await client.GetFromJsonAsync<PagedResult<EmployeeDto>>(url);

        return new TableData<EmployeeDto>
            {
                Items = result?.Items ?? [],
                TotalItems = result?.TotalCount ?? 0
            };
    }

    private async Task ReloadTable()
    {
        if (_table is not null)
        {
            await _table.ReloadServerData();
        }
    }

    private bool FilterFunc(EmployeeDto e) =>
        string.IsNullOrWhiteSpace(searchString) ||
        e.FirstName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true ||
        e.LastName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true ||
        e.NationalId?.Contains(searchString, StringComparison.OrdinalIgnoreCase) == true;
}


