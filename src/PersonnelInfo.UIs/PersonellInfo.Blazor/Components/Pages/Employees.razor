@page "/"
@rendermode InteractiveServer
@inject HttpClient httpClient
@inject IDisplayName displayName
@using PersonnelInfo.Application.Interfaces.Entities
@using PersonnelInfo.Core.DTOs.Entities.Employees
@using System.Net.Http.Json


<MudTable FixedHeader="@fixedHeader" height="500px" FixedFooter="@fixedFooter" Items="@employees" Dense="@dense" Hover Bordered="@bordered" Striped="@striped" Filter="new Func<EmployeeDto,bool>(FilterFunc1)" @bind-SelectedItem="selectedEmployee">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Employees</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="searchString1" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
    </ToolBarContent>

    <HeaderContent>
        <MudTh>ویرایش</MudTh>
        <DisplayNameProvider PropertyList="@propertyList" SearchString="searchString1" IsMudTh=true EntityType=typeof(EmployeeDto) PropertyNameString="RowNumber" />

        @* <DisplayNameProvider IsMudTh=true Type=typeof(EmployeeDto) PropertyNameString="RowNumber" />
        <DisplayNameProvider IsMudTh=true Type=typeof(EmployeeDto) PropertyNameString="PersonnelCode" />
        <DisplayNameProvider IsMudTh=true Type=typeof(EmployeeDto) PropertyNameString="FirstName" />
        <DisplayNameProvider IsMudTh=true Type=typeof(EmployeeDto) PropertyNameString="LastName" />
        <DisplayNameProvider IsMudTh=true Type=typeof(EmployeeDto) PropertyNameString="NationalId" />
        <DisplayNameProvider IsMudTh=true Type=typeof(EmployeeDto) PropertyNameString="ContactNumber" /> *@
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="ٍویرایش"><MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" OnClick="@(e=>Edit<long>("/update-employee/",context.Id))" class="btn btn-primary"></MudIconButton></MudTd>
        <DisplayNameProvider IsMudTd=true PropertyList="@propertyList" EntityType=typeof(EmployeeDto) PropertyNameString="RowNumber" Context="@context" />

       @* <DisplayNameProvider IsMudTd=true EntityType=typeof(EmployeeDto) PropertyNameString="RowNumber" Context="@context" />
        <DisplayNameProvider IsMudTd=true EntityType=typeof(EmployeeDto) PropertyNameString="PersonnelCode">@context.PersonnelCode</DisplayNameProvider>
        <DisplayNameProvider IsMudTd=true EntityType=typeof(EmployeeDto) PropertyNameString="FirstName">@context.FirstName</DisplayNameProvider>
        <DisplayNameProvider IsMudTd=true EntityType=typeof(EmployeeDto) PropertyNameString="LastName">@context.LastName</DisplayNameProvider>
        <DisplayNameProvider IsMudTd=true EntityType=typeof(EmployeeDto) PropertyNameString="NationalId">@context.NationalId</DisplayNameProvider>
        <DisplayNameProvider IsMudTd=true EntityType=typeof(EmployeeDto) PropertyNameString="ContactNumber">@context.ContactNumber</DisplayNameProvider> *@
    </RowTemplate>
    <PagerContent>
        <MudTablePager PageSizeOptions=[1000,2000,3000,4000] />
    </PagerContent>

</MudTable>




@code {
    private bool dense = true;
    private bool striped = true;
    private bool bordered = true;
    private string searchString1 = "";
    private bool fixedHeader = true;
    private bool fixedFooter = false;
    private EmployeeDto employeeDto = new();
    [Inject] private NavigationManager navManager { get; set; }



    private void Edit<T>(string uri, T id) =>
        navManager.NavigateTo($"{uri}{id}");

    private int SetRowNumber<T>(T context, IEnumerable<T> list)
    {
        return list.ToList().IndexOf(context) + 1 + (mudTable?.CurrentPage ?? 0) * (mudTable?.RowsPerPage ?? 0);
    }

    private List<string> propertyList = [];

    [Inject]
    private IOptions<ApiConfiguration> apiConfig { get; set; }

    private EmployeeDto selectedEmployee;
    private MudTable<EmployeeDto> mudTable;
    private IEnumerable<EmployeeDto> employees = [];
    private CancellationTokenSource cts = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await httpClient.GetFromJsonAsync<PagedResult<EmployeeDto>>($"{apiConfig.Value.Url}/api/employee?page=1&pageSize=150", cts.Token);

        employees = result?.Items ?? [];

        var index = 0;
        foreach (var employee in employees)
        {
            employee.RowNumber = ++index;
        }
        SetPropertyList();
    }

    private void SetPropertyList()
    {
        var obj = new AddEmployeeDto();
        propertyList = new()
        {
            nameof(obj.PersonnelCode),
            nameof(obj.FirstName),
            nameof(obj.LastName),
            nameof(obj.NationalId),
            nameof(obj.ContactNumber)
        };
    }

    private bool FilterFunc1(EmployeeDto employee) => Filter(employee, searchString1);

    public bool Filter(EmployeeDto employee, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        return $"{employee.PersonnelCode} {employee.FirstName} {employee.LastName} {employee.NationalId} {employee.ContactNumber} {employee.GenderDisplay} {employee.WorkingStatusDisplay} {employee.FatherName} {employee.MaritalStatus} {employee.ChildrenCount} {employee.ShenasnameNumber} {employee.ShenasnameSerialLetter} {employee.ShenasnameSerie} {employee.ShenasnameSerial} {employee.BirthDate} {employee.BirthPlaceId} {employee.ShenasnameIssuedPlaceId} {employee.InsurranceCode} {employee.InsurranceStatus} {employee.HasInsurance} {employee.ExtraInsurranceCount} {employee.DepartmentId} {employee.EmploymentTypeDisplay} {employee.StartingDate:yyyy-MM-dd} {employee.LeavingDate?.ToString("yyyy-MM-dd")} {employee.SupervisorId} {employee.InternalContactNumber} {employee.LandPhoneNumber} {employee.Address} {employee.PostalCode} {employee.MostRecentDegree} {employee.Major}".Contains(searchString, StringComparison.OrdinalIgnoreCase);
    }
}





